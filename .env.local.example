NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor: registra el resultado de los pagos. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pagos: simulado (desarrollo), pruebas o produccion
AZUL_MODE=simulado
AZUL_MERCHANT_ID=
AZUL_MERCHANT_NAME=
AZUL_MERCHANT_TYPE=
AZUL_AUTH_KEY=

# Transferencias al cobrar: manual (el fundador las ejecuta y las marca en /admin)
PAYOUTS_PROVIDER=manual
