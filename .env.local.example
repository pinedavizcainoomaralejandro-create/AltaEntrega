NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor: registra el resultado de los pagos. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Correos de aviso (solicitudes de negocio y repartidor) con Resend. Vacío = no se envían.
RESEND_API_KEY=
# Remitente: un dominio verificado en Resend. Sin definir usa onboarding@resend.dev (solo para pruebas).
EMAIL_FROM=AltaEntrega <avisos@tu-dominio.com>
# Opcional: a quién avisar de solicitudes nuevas (separados por comas). Vacío = todos los admins.
ADMIN_EMAILS=

# Notificaciones push de las apps (ver docs/push.md).
# Activa el registro en las apps: solo cuando las apps publicadas incluyan google-services.json.
NEXT_PUBLIC_PUSH_ENABLED=false
# Secreto compartido con la base de datos (private.push_config). Mínimo 32 caracteres.
PUSH_WEBHOOK_SECRET=
# Android: de la cuenta de servicio de Firebase (no el JSON entero).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# iOS: clave de APNs (.p8) de la cuenta de Apple Developer.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.altaentrega.app
# sandbox para builds de Xcode en desarrollo; production para TestFlight y App Store.
APNS_ENV=production

# Pagos: simulado (desarrollo), pruebas o produccion
AZUL_MODE=simulado
AZUL_MERCHANT_ID=
AZUL_MERCHANT_NAME=
AZUL_MERCHANT_TYPE=
AZUL_AUTH_KEY=

# Transferencias al cobrar: manual (el fundador las ejecuta y las marca en /admin)
PAYOUTS_PROVIDER=manual

# Enlaces de descarga de las apps (anuncio del login). Vacío = "Próximamente".
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
